{
  "schema": "watermark-tool@1",
  "exportedAt": "2026-07-27T00:00:00.000Z",
  "configs": [
    {
      "id": "sample-prod",
      "name": "Production",
      "shortLabel": "PROD",
      "enabled": true,
      "rules": [
        { "type": "host-exact", "value": "app.example.com" }
      ],
      "text": "Production - Caution",
      "color": "#ef4444",
      "opacity": 0.15,
      "density": 300,
      "fontSize": 24,
      "rotation": -30,
      "smartColor": false,
      "smartColorTone": "light",
      "border": { "enabled": true, "color": "#ef4444", "width": 4 },
      "mouseFade": { "enabled": true, "fadeOpacity": 0.03, "resumeDelay": 2000 }
    },
    {
      "id": "sample-pre",
      "name": "Pre-production",
      "shortLabel": "PRE",
      "enabled": true,
      "rules": [
        { "type": "host-suffix", "value": "pre.example.com" },
        { "type": "cookie", "value": "env=pre" }
      ],
      "text": "Pre-production",
      "color": "#f59e0b",
      "opacity": 0.12,
      "density": 300,
      "fontSize": 24,
      "rotation": -30,
      "smartColor": true,
      "smartColorTone": "light",
      "border": { "enabled": false, "color": "#f59e0b", "width": 4 },
      "mouseFade": { "enabled": true, "fadeOpacity": 0.03, "resumeDelay": 2000 }
    },
    {
      "id": "sample-test",
      "name": "Test / Staging",
      "shortLabel": "TEST",
      "enabled": true,
      "rules": [
        { "type": "host-suffix", "value": "test.example.com" },
        { "type": "url-regex", "value": "^https?://.*\\.test\\..*" }
      ],
      "text": "Testing",
      "color": "#10b981",
      "opacity": 0.12,
      "density": 300,
      "fontSize": 24,
      "rotation": -30,
      "smartColor": true,
      "smartColorTone": "light",
      "border": { "enabled": false, "color": "#10b981", "width": 4 },
      "mouseFade": { "enabled": true, "fadeOpacity": 0.03, "resumeDelay": 2000 }
    },
    {
      "id": "sample-admin",
      "name": "Admin Panel",
      "shortLabel": "ADMIN",
      "enabled": true,
      "rules": [
        { "type": "url-regex", "value": "^https?://[^/]+/admin(/.*)?$" },
        { "type": "ip-cidr", "value": "10.0.0.0/8" }
      ],
      "text": "Admin Panel - Internal",
      "color": "#8b5cf6",
      "opacity": 0.15,
      "density": 300,
      "fontSize": 24,
      "rotation": -30,
      "smartColor": true,
      "smartColorTone": "light",
      "border": { "enabled": true, "color": "#8b5cf6", "width": 4 },
      "mouseFade": { "enabled": true, "fadeOpacity": 0.03, "resumeDelay": 2000 }
    }
  ]
}
